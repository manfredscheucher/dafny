<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>DafnyPipeline</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\Binaries\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <RollForward>Major</RollForward>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Working around some stange behavior in dotnet publish: https://github.com/dotnet/sdk/issues/10566 -->
  <PropertyGroup Condition="$(RUNTIME_IDENTIFIER) != ''">
    <RuntimeIdentifier>$(RUNTIME_IDENTIFIER)</RuntimeIdentifier>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\DafnyCore\DafnyCore.csproj" />
  </ItemGroup>

  <!--
  Build the Kotlin runtime into a self-contained jar (including the Kotlin stdlib via
  -include-runtime) so it can be embedded as a resource, extracted at compile time and used
  on the classpath for compiling/running generated Kotlin code.
  This mirrors how DafnyRuntime.jar is produced for the Java backend, but uses kotlinc
  directly because there is no full Gradle project checked in for this source subset.
  Requires `kotlinc` to be on PATH at build time. If you need to regenerate the jar manually:
    kotlinc Source/DafnyRuntime/DafnyRuntimeKotlin/src/main/kotlin/dafny/*.kt \
      -include-runtime -d Source/DafnyRuntime/DafnyRuntimeKotlin/build/libs/DafnyRuntimeKotlin.jar
  -->
  <PropertyGroup>
    <DafnyRuntimeKotlinJar>..\DafnyRuntime\DafnyRuntimeKotlin\build\libs\DafnyRuntimeKotlin.jar</DafnyRuntimeKotlinJar>
  </PropertyGroup>
  <ItemGroup>
    <!-- KMP module: java-free commonMain plus the JVM actual (jvmMain, dafny.BigInteger
         over java.math). For the embedded JVM runtime jar we compile both source sets. -->
    <DafnyRuntimeKotlinInputFile Include="..\DafnyRuntime\DafnyRuntimeKotlin\src\commonMain\kotlin\dafny\*.kt" />
    <DafnyRuntimeKotlinInputFile Include="..\DafnyRuntime\DafnyRuntimeKotlin\src\commonMain\kotlin\_System\*.kt" />
    <DafnyRuntimeKotlinInputFile Include="..\DafnyRuntime\DafnyRuntimeKotlin\src\jvmMain\kotlin\dafny\*.kt" />
    <DafnyRuntimeKotlinInputFile Include="..\DafnyRuntime\DafnyRuntimeKotlin\src\jvmMain\kotlin\_System\*.kt" />
  </ItemGroup>
  <Target Name="BuildDafnyRuntimeKotlinJar" BeforeTargets="BeforeBuild;PrepareForBuild"
          Inputs="@(DafnyRuntimeKotlinInputFile)" Outputs="$(DafnyRuntimeKotlinJar)">
    <Message Text="Compiling DafnyRuntimeKotlin to $(DafnyRuntimeKotlinJar)..." Importance="high" />
    <MakeDir Directories="..\DafnyRuntime\DafnyRuntimeKotlin\build\libs" />
    <PropertyGroup>
      <DafnyRuntimeKotlinSources>@(DafnyRuntimeKotlinInputFile->'&quot;%(FullPath)&quot;', ' ')</DafnyRuntimeKotlinSources>
    </PropertyGroup>
    <!-- expect/actual needs the Kotlin Multiplatform compilation model, which flat kotlinc
         doesn't provide, so build the JVM runtime jar via the module's Gradle build and copy
         it to the embedded location. -->
    <Exec Command="gradle -q jvmJar" WorkingDirectory="..\DafnyRuntime\DafnyRuntimeKotlin"
          Condition="'@(DafnyRuntimeKotlinInputFile)' != ''" />
    <Copy SourceFiles="..\DafnyRuntime\DafnyRuntimeKotlin\build\libs\DafnyRuntimeKotlin-jvm-1.0.jar"
          DestinationFiles="$(DafnyRuntimeKotlinJar)"
          Condition="'@(DafnyRuntimeKotlinInputFile)' != ''" />
    <ItemGroup>
      <FileWrites Include="$(DafnyRuntimeKotlinJar)" />
    </ItemGroup>
  </Target>

  <!-- Zip the full Kotlin Multiplatform runtime SOURCE tree (commonMain + jvmMain + nonJvmMain
       + jsMain + nativeMain, plus build.gradle.kts / settings.gradle.kts) so the kmp target
       backend can unpack it into a generated Gradle project and build for jvm/js/native. Unlike
       the embedded JVM jar (JVM-only), KMP needs the sources to compile each platform's actual. -->
  <PropertyGroup>
    <DafnyRuntimeKotlinModule>..\DafnyRuntime\DafnyRuntimeKotlin</DafnyRuntimeKotlinModule>
    <DafnyRuntimeKotlinSourcesZip>$(IntermediateOutputPath)DafnyRuntimeKotlinSources.zip</DafnyRuntimeKotlinSourcesZip>
  </PropertyGroup>
  <ItemGroup>
    <DafnyRuntimeKotlinSrcFile Include="$(DafnyRuntimeKotlinModule)\src\**\*.kt" />
    <DafnyRuntimeKotlinGradleFile Include="$(DafnyRuntimeKotlinModule)\build.gradle.kts" />
    <DafnyRuntimeKotlinGradleFile Include="$(DafnyRuntimeKotlinModule)\settings.gradle.kts" />
  </ItemGroup>
  <Target Name="ZipDafnyRuntimeKotlinSources" BeforeTargets="BeforeBuild;PrepareForBuild"
          Inputs="@(DafnyRuntimeKotlinSrcFile);@(DafnyRuntimeKotlinGradleFile)" Outputs="$(DafnyRuntimeKotlinSourcesZip)">
    <PropertyGroup>
      <KmpStageDir>$(IntermediateOutputPath)kmp-runtime-src\</KmpStageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(KmpStageDir)" />
    <MakeDir Directories="$(KmpStageDir)" />
    <!-- Stage only the source tree + gradle files (NOT build/), preserving relative paths. -->
    <Copy SourceFiles="@(DafnyRuntimeKotlinSrcFile)"
          DestinationFiles="@(DafnyRuntimeKotlinSrcFile->'$(KmpStageDir)src\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(DafnyRuntimeKotlinGradleFile)"
          DestinationFolder="$(KmpStageDir)" />
    <Delete Files="$(DafnyRuntimeKotlinSourcesZip)" />
    <ZipDirectory SourceDirectory="$(KmpStageDir)"
                  DestinationFile="$(DafnyRuntimeKotlinSourcesZip)"
                  Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="$(DafnyRuntimeKotlinSourcesZip)" />
    </ItemGroup>
  </Target>

  <!-- 
  Note that the CopyToOutputDirectory elements are important to ensure the runtime files
  appear in the zip file distribution created by package.py.
  If we manage to fully transition to a cleaner distribution as a `dotnet tool` instead,
  we may be able to get away with only embedding these files inside this assembly.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-notarget.doo">
      <LogicalName>DafnyStandardLibraries-notarget.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-java.doo">
      <LogicalName>DafnyStandardLibraries-java.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-cs.doo">
      <LogicalName>DafnyStandardLibraries-cs.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-js.doo">
      <LogicalName>DafnyStandardLibraries-js.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-go.doo">
      <LogicalName>DafnyStandardLibraries-go.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries-py.doo">
      <LogicalName>DafnyStandardLibraries-py.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.cs">
      <LinkBase>DafnyStandardLibraries_cs</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.java">
      <LinkBase>DafnyStandardLibraries_java</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.js">
      <LinkBase>DafnyStandardLibraries_js</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.go">
      <LinkBase>DafnyStandardLibraries_go</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyStandardLibraries\src\Std\*Externs\**\*.py">
      <LinkBase>DafnyStandardLibraries_py</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>

    <EmbeddedResource Include="..\DafnyStandardLibraries\binaries\DafnyStandardLibraries.doo">
      <LogicalName>DafnyStandardLibraries.doo</LogicalName>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeJava\src\main\java\**\*.java">
      <LinkBase>DafnyRuntimeJava</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeJava\src\main\dafny-generated\**\*.java">
      <LinkBase>DafnyRuntimeJava</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeJava\build\libs\DafnyRuntime-4.11.1.jar">
      <LogicalName>DafnyRuntime.jar</LogicalName>
      <Link>DafnyRuntime.jar</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeKotlin\build\libs\DafnyRuntimeKotlin.jar">
      <LogicalName>DafnyRuntimeKotlin.jar</LogicalName>
      <Link>DafnyRuntimeKotlin.jar</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <!-- The full KMP runtime source tree (zipped by ZipDafnyRuntimeKotlinSources), used by
         the kmp target backend to build for jvm/js/native. -->
    <EmbeddedResource Include="$(DafnyRuntimeKotlinSourcesZip)">
      <LogicalName>DafnyRuntimeKotlinSources.zip</LogicalName>
      <Link>DafnyRuntimeKotlinSources.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntime.cs">
      <LinkBase>DafnyRuntimeCsharp</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeSystemModule.cs">
      <LinkBase>DafnyRuntimeCsharp</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeGo\**\*.go" Exclude="..\DafnyRuntime\DafnyRuntimeGo\**\*_test.go">
      <LinkBase>DafnyRuntimeGo</LinkBase>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeCpp\**\*.h">
      <LinkBase>DafnyRuntimeCpp</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeCpp\**\*.cpp">
      <LinkBase>DafnyRuntimeCpp</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeJs\**\*.js">
      <LinkBase>DafnyRuntimeJs</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimePython\**\*.py">
      <LinkBase>DafnyRuntimePython</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DafnyRuntime\DafnyRuntimeRust\**" Exclude="..\DafnyRuntime\DafnyRuntimeRust\.gitignore" LinkBase="DafnyRuntimeRust">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Remove="..\DafnyRuntime\DafnyRuntimeRust\target\**"/>
  </ItemGroup>

</Project>
